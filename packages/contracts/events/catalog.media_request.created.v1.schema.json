{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog.media_request.created.v1.schema.json",
  "title": "catalog.media_request.created.v1",
  "type": "object",
  "required": [
    "request_id",
    "user_id",
    "kind",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "enum": [
        "song",
        "movie",
        "series",
        "other"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
