{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user.deletion.requested.v1.schema.json",
  "title": "user.deletion.requested.v1",
  "type": "object",
  "required": [
    "user_id",
    "request_id",
    "requested_at"
  ],
  "additionalProperties": false,
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "attempt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
