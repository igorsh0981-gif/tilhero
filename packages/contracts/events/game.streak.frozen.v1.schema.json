{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game.streak.frozen.v1.schema.json",
  "title": "game.streak.frozen.v1",
  "type": "object",
  "required": [
    "user_id",
    "local_date",
    "op_id",
    "freeze_left",
    "frozen_at"
  ],
  "additionalProperties": false,
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "local_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "op_id": {
      "type": "string",
      "format": "uuid"
    },
    "freeze_left": {
      "type": "integer",
      "minimum": 0
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
