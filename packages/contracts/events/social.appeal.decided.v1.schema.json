{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "social.appeal.decided.v1.schema.json",
  "title": "social.appeal.decided.v1",
  "type": "object",
  "required": [
    "appeal_id",
    "sanction_id",
    "user_id",
    "decision",
    "decided_at"
  ],
  "additionalProperties": false,
  "properties": {
    "appeal_id": {
      "type": "string",
      "format": "uuid"
    },
    "sanction_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "decision": {
      "type": "string",
      "enum": [
        "upheld",
        "overturned"
      ]
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
