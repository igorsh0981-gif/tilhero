{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "social.profile.updated.v1.schema.json",
  "title": "social.profile.updated.v1",
  "type": "object",
  "required": [
    "user_id",
    "member_id",
    "nickname",
    "game_profile_hidden",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "member_id": {
      "type": "string",
      "pattern": "^mb_[A-Za-z0-9_-]{22}$"
    },
    "nickname": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 3,
      "maxLength": 20
    },
    "game_profile_hidden": {
      "type": "boolean"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
