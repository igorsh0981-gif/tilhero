{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game.rules.activated.v1.schema.json",
  "title": "game.rules.activated.v1",
  "type": "object",
  "required": [
    "version",
    "activated_by",
    "activated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "based_on": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "activated_by": {
      "type": "string",
      "format": "uuid"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
