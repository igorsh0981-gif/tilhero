{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "social.block.changed.v1.schema.json",
  "title": "social.block.changed.v1",
  "type": "object",
  "required": [
    "blocker_user_id",
    "blocked_user_id",
    "status",
    "at"
  ],
  "additionalProperties": false,
  "properties": {
    "blocker_user_id": {
      "type": "string",
      "format": "uuid"
    },
    "blocked_user_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "added",
        "removed"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
