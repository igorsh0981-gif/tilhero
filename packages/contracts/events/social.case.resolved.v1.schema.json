{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "social.case.resolved.v1.schema.json",
  "title": "social.case.resolved.v1",
  "type": "object",
  "required": [
    "case_id",
    "reporter_user_id",
    "outcome",
    "resolved_at"
  ],
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "reporter_user_id": {
      "type": "string",
      "format": "uuid"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "action_taken",
        "dismissed"
      ]
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
