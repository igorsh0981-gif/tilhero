{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game.referral.rewarded.v1.schema.json",
  "title": "game.referral.rewarded.v1",
  "type": "object",
  "required": [
    "referral_id",
    "inviter_user_id",
    "rewarded_at"
  ],
  "additionalProperties": false,
  "properties": {
    "referral_id": {
      "type": "string",
      "format": "uuid"
    },
    "inviter_user_id": {
      "type": "string",
      "format": "uuid"
    },
    "invitee_user_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "rewarded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
