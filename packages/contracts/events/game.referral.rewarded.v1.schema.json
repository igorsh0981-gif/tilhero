{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game.referral.rewarded.v1.schema.json",
  "title": "game.referral.rewarded.v1",
  "type": "object",
  "required": [
    "referral_id",
    "inviter_user_id",
    "rewarded_at"
  ],
  "additionalProperties": false,
  "properties": {
    "referral_id": {
      "type": "string",
      "format": "uuid"
    },
    "inviter_user_id": {
      "type": "string",
      "format": "uuid"
    },
    "invitee_user_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "rewarded_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "rewarded",
            "legacy",
            "inviter_capped"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "inviter_reward": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "freeze",
            "til"
          ],
          "properties": {
            "freeze": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "til": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
