{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user.domain.deleted.v1.schema.json",
  "title": "user.domain.deleted.v1",
  "type": "object",
  "required": [
    "user_id",
    "request_id",
    "domain",
    "mode"
  ],
  "additionalProperties": false,
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "domain": {
      "type": "string",
      "maxLength": 200
    },
    "mode": {
      "type": "string",
      "enum": [
        "deleted",
        "anonymized"
      ]
    }
  }
}
