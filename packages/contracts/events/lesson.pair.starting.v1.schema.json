{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson.pair.starting.v1.schema.json",
  "title": "lesson.pair.starting.v1",
  "type": "object",
  "required": [
    "room_id",
    "user_ids",
    "scenario_id",
    "start_at"
  ],
  "additionalProperties": false,
  "properties": {
    "room_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "maxItems": 2,
      "minItems": 2,
      "uniqueItems": true
    },
    "scenario_id": {
      "type": "string",
      "maxLength": 200
    },
    "start_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
