{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog.media_request.decided.v1.schema.json",
  "title": "catalog.media_request.decided.v1",
  "type": "object",
  "required": [
    "request_id",
    "user_id",
    "status",
    "title",
    "decided_at"
  ],
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "authored_alternative",
        "licensed",
        "rejected",
        "duplicate"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "linked_asset_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
