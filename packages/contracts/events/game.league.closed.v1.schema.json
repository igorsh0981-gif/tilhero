{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game.league.closed.v1.schema.json",
  "title": "game.league.closed.v1",
  "type": "object",
  "required": [
    "week",
    "group_id",
    "version",
    "pair_id",
    "level_band",
    "prizes_held",
    "standings",
    "closed_at"
  ],
  "additionalProperties": false,
  "properties": {
    "week": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "group_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "pair_id": {
      "type": "string",
      "maxLength": 200
    },
    "level_band": {
      "type": "string",
      "enum": [
        "A0-A1",
        "A2",
        "B1+"
      ]
    },
    "prizes_held": {
      "type": "boolean"
    },
    "standings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user_id",
          "place",
          "xp",
          "prize_til"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "place": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "xp": {
            "type": "integer",
            "minimum": 0
          },
          "prize_til": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      },
      "maxItems": 50
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
