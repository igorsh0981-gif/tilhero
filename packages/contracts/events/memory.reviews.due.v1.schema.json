{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory.reviews.due.v1.schema.json",
  "title": "memory.reviews.due.v1",
  "type": "object",
  "required": [
    "user_id",
    "local_date",
    "due_count",
    "timezone"
  ],
  "additionalProperties": false,
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "local_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "due_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "timezone": {
      "type": "string",
      "maxLength": 200
    }
  }
}
