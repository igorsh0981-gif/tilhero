{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog.version.published.v1.schema.json",
  "title": "catalog.version.published.v1",
  "type": "object",
  "required": [
    "kind",
    "key",
    "action",
    "published_at"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "course",
        "skill",
        "module",
        "lesson",
        "rubric",
        "scenario",
        "media_asset",
        "media_exercise",
        "reading"
      ]
    },
    "key": {
      "type": "string",
      "maxLength": 200
    },
    "version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "published",
        "rolled_back",
        "archived"
      ]
    },
    "course_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "published_by": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
