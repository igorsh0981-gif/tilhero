{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning.trajectory.updated.v1.schema.json",
  "title": "learning.trajectory.updated.v1",
  "type": "object",
  "required": [
    "user_id",
    "pair_id",
    "revision",
    "computed_at"
  ],
  "additionalProperties": false,
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "pair_id": {
      "type": "string",
      "maxLength": 200
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "next_lesson_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_codes": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxItems": 10
        },
        {
          "type": "null"
        }
      ]
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
