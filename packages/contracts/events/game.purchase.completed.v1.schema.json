{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game.purchase.completed.v1.schema.json",
  "title": "game.purchase.completed.v1",
  "type": "object",
  "required": [
    "purchase_id",
    "user_id",
    "item_code",
    "item_kind",
    "price_til",
    "purchased_at"
  ],
  "additionalProperties": false,
  "properties": {
    "purchase_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "item_code": {
      "type": "string",
      "pattern": "^[a-z0-9_]{3,40}$"
    },
    "item_kind": {
      "type": "string",
      "enum": [
        "background",
        "hero_frame",
        "streak_freeze"
      ]
    },
    "price_til": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "purchased_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
