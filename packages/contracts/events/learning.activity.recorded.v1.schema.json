{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning.activity.recorded.v1.schema.json",
  "title": "learning.activity.recorded.v1",
  "type": "object",
  "required": [
    "user_id",
    "activity_id",
    "local_date",
    "kind",
    "minutes",
    "recorded_at"
  ],
  "additionalProperties": false,
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "activity_id": {
      "type": "string",
      "format": "uuid"
    },
    "local_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "lesson",
        "review",
        "practice",
        "diagnostic"
      ]
    },
    "minutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 240
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "streak_days": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
