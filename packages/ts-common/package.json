{
  "name": "@tilhero/ts-common",
  "version": "0.1.0",
  "private": true,
  "description": "TilHero: общий каркас Node/Fastify-сервисов (контекст трассировки, формат ошибок, внутренний JWT, клиент сервисов, health)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.1",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
