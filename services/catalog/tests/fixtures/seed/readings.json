    "paragraphs": [
      {
        "p_id": "p1",
        "sentences": [
          {
            "s_id": "s1",
            "text_en": "This is my cat.",
            "gloss": {
              "ru": "Это мой кот.",
              "uz": "Bu mening mushugim."
            }
          },
          {
            "s_id": "s2",
            "text_en": "His name is Max.",
            "gloss": {
              "ru": "Его зовут Макс.",
              "uz": "Uning ismi Maks."
            }
          },
          {
            "s_id": "s3",
            "text_en": "Max is big and orange.",
            "gloss": {
              "ru": "Макс большой и рыжий.",
              "uz": "Maks katta va sariq."
            }
          },
          {
            "s_id": "s4",
            "text_en": "He likes to sleep on my bed.",
            "gloss": {
              "ru": "Он любит спать на моей кровати.",
              "uz": "U mening karavotimda uxlashni yaxshi koʻradi."
            }
          }
        ]
      },
      {
        "p_id": "p2",
        "sentences": [
          {
            "s_id": "s5",
            "text_en": "In the morning, Max is very hungry.",
            "gloss": {
              "ru": "Утром Макс очень голодный.",
              "uz": "Ertalab Maks juda och boʻladi."
            }
          },
          {
            "s_id": "s6",
            "text_en": "I give him milk and fish.",
            "gloss": {
              "ru": "Я даю ему молоко и рыбу.",
              "uz": "Men unga sut va baliq beraman."
            }
          },
          {
            "s_id": "s7",
            "text_en": "Then we play with a small red ball.",
            "gloss": {
              "ru": "Потом мы играем с маленьким красным мячом.",
              "uz": "Keyin biz kichik qizil toʻp bilan oʻynaymiz."
            }
          },
          {
            "s_id": "s8",
            "text_en": "Max can jump very high!",
            "gloss": {
              "ru": "Макс умеет прыгать очень высоко!",
              "uz": "Maks juda baland sakray oladi!"
            }
          }
        ]
      },
      {
        "p_id": "p3",
        "sentences": [
          {
            "s_id": "s9",
            "text_en": "In the evening, Max sits with my family.",
            "gloss": {
              "ru": "Вечером Макс сидит с моей семьёй.",
              "uz": "Kechqurun Maks oilam bilan oʻtiradi."
            }
          },
          {
            "s_id": "s10",
            "text_en": "He is a happy cat, and I love him.",
            "gloss": {
              "ru": "Он счастливый кот, и я его люблю.",
              "uz": "U baxtli mushuk va men uni yaxshi koʻraman."
            }
          }
        ]
      }
    ],
