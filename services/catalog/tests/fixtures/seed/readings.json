    "paragraphs": [
      {
        "p_id": "p1",
        "sentences": [
          {
            "s_id": "s1",
            "text_en": "Every morning, Anna goes to a small coffee shop near her office.",
            "gloss": {
              "ru": "Каждое утро Анна ходит в маленькую кофейню рядом с офисом.",
              "uz": "Har kuni ertalab Anna ofisi yonidagi kichik qahvaxonaga boradi."
            }
          },
          {
            "s_id": "s2",
            "text_en": "She usually orders a cup of tea with milk.",
            "gloss": {
              "ru": "Обычно она заказывает чашку чая с молоком.",
              "uz": "U odatda sutli bir piyola choy buyurtma qiladi."
            }
          },
          {
            "s_id": "s3",
            "text_en": "The barista, Tom, always says hello and asks about her day.",
            "gloss": {
              "ru": "Бариста Том всегда здоровается и спрашивает, как у неё дела.",
              "uz": "Barista Tom doim salomlashadi va kuni qanday oʻtayotganini soʻraydi."
            }
          }
        ]
      },
      {
        "p_id": "p2",
        "sentences": [
          {
            "s_id": "s4",
            "text_en": "Today the shop is very busy, so Anna waits in line for ten minutes.",
            "gloss": {
              "ru": "Сегодня в кофейне очень много людей, поэтому Анна ждёт в очереди десять минут.",
              "uz": "Bugun qahvaxonada odam juda koʻp, shuning uchun Anna navbatda oʻn daqiqa kutadi."
            }
          },
          {
            "s_id": "s5",
            "text_en": "When it is her turn, she wants to try something new.",
            "gloss": {
              "ru": "Когда подходит её очередь, она хочет попробовать что-то новое.",
              "uz": "Navbati kelganda u yangi narsani tatib koʻrmoqchi."
            }
          },
          {
            "s_id": "s6",
            "text_en": "She asks for a hot chocolate and a small piece of cake.",
            "gloss": {
              "ru": "Она просит горячий шоколад и маленький кусочек торта.",
              "uz": "U issiq shokolad va kichik bir boʻlak tort soʻraydi."
            }
          },
          {
            "s_id": "s7",
            "text_en": "It costs five pounds, and she pays by card.",
            "gloss": {
              "ru": "Это стоит пять фунтов, и она платит картой.",
              "uz": "Bu besh funt turadi va u karta bilan toʻlaydi."
            }
          },
          {
            "s_id": "s8",
            "text_en": "Anna likes her new drink and decides to come back tomorrow.",
            "gloss": {
              "ru": "Анне нравится новый напиток, и она решает прийти снова завтра.",
              "uz": "Annaga yangi ichimlik yoqadi va u ertaga yana kelishga qaror qiladi."
            }
          }
        ]
      }
    ],
